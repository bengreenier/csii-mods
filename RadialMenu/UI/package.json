{
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "webpack",
    "dev": "webpack --watch",
    "update": "npx create-csii-ui-mod update",
    "clean": "npx create-csii-ui-mod clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc -p tsconfig.test.json",
